{
  "name": "@jioplix/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "nodemon --watch src --ignore dist --exec \"tsc && node dist/main.js\" --ext ts",
    "prebuild": "npm run build --workspace @jioplix/contracts --workspace @jioplix/db",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@jioplix/contracts": "*",
    "@jioplix/db": "*",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/schedule": "^6.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-orm": "^0.45.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "openai": "^7.5.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.24.0",
    "rxjs": "^7.8.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.6",
    "nodemon": "^3.1.14",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  }
}
