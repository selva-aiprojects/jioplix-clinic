{
  "name": "jioplix",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @jioplix/web",
    "dev:api": "npm run dev -w @jioplix/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db": "npm run cli -w @jioplix/db",
    "smoke": "node scripts/smoke-test.mjs",
    "postinstall": "npm run build -w @jioplix/contracts && npm run build -w @jioplix/db"
  }
}
