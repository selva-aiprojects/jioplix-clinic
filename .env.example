DATABASE_URL=postgres://jioplix:jioplix@localhost:5432/jioplix
REDIS_URL=redis://localhost:6379
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=jioplix
S3_SECRET_KEY=jioplix-secret
S3_BUCKET=jioplix-documents
VITE_API_URL=https://your-api-domain.com/api/v1

# --- Phone OTP (see docs/phone-otp-provider-design.md) ---
# Demo mode: show the code on-screen for allowlisted demo phones (demo only).
DEMO_OTP_ENABLED=true
DEMO_OTP_ALLOWLIST=+919800000101,+919800000102,+919800000201,+919800000202,+919800000203
DEMO_OTP_TTL_SECONDS=300
# Real path (production sign-off): Supabase Auth as the OTP engine.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=...        # publishable key (server-side use)
# SUPABASE_SERVICE_ROLE_KEY=... # service-role key (keep server-side only)

# --- MSG91 (alternative real path, wins over Supabase when both are set) ---
# India SMS/WhatsApp OTP via MSG91 Auth API v5 — see docs/sms-dlt-provider.md.
# MSG91_AUTH_KEY=...            # MSG91 dashboard -> API & Automation auth key
# MSG91_TEMPLATE_ID=...         # DLT-approved OTP template id (OTP section)
# MSG91_OTP_LENGTH=6            # optional, 4-9
# MSG91_OTP_EXPIRY_MINUTES=5    # optional
# MSG91_BASE_URL=https://control.msg91.com   # optional; override only for a mock/sandbox
